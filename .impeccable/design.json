  "narrative": {
    "northStar": "The Simulation Floor",
    "overview": "The page reads as a research paper laid on cool paper and opens on the mechanism itself: an isometric pixel-art cutaway where simulated users work on laptops, desktops, tablets, phones and a smart speaker, each carrying frustration, fatigue and motivation and leaving by the hazard rule the paper prints. Interface chrome borrows the grammar of early one-bit desktops: windows with striped title bars, hard-edged buttons with offset shadows, dithered fills.",
    "keyCharacteristics": [
      "Cool paper ground, near-black ink, one accent (screen glow cyan).",
      "Three state colours used only as data: frustration, fatigue, motivation.",
      "One-bit desktop windows for figures and the form; pixel buttons with hard offset shadows.",
      "Pixel art at whole-device-pixel scale, image-rendering: pixelated, authored as code.",
      "Text always in the DOM, never inside the canvas."
    ],
    "rules": [
      {
        "name": "The One Glow Rule",
        "body": "Screen glow is the only accent. Links are ink with an underline; a second accent (a link blue) is a defect.",
        "section": "colors"
      },
      {
        "name": "The Data-Only Triad Rule",
        "body": "Coral, amber and green mean frustration, fatigue and motivation. They never decorate props, clothes, headings or buttons.",
        "section": "colors"
      },
      {
        "name": "The Lowercase Brand Rule",
        "body": "\"onpuck\" is never set in Silkscreen, because the face has no lowercase. Labels that would contain the name are reworded or set in the grotesk.",
        "section": "typography"
      },
      {
        "name": "The Mono Is Measurement Rule",
        "body": "Martian Mono appears only where a value is measured, computed or typed. Never as a \"technical\" costume for prose.",
        "section": "typography"
      },
      {
        "name": "The Press-In Rule",
        "body": "Offset shadows are mechanical: hover lifts by 1 px, press translates into the shadow and removes it. They never soften, blur or tint.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep every word in the DOM; the canvas holds pixels and icons only.",
      "**Do** scale pixel art by whole device pixels and keep `image-rendering: pixelated` on the poster and canvas.",
      "**Do** draw new icons as pixel grids (`components/ui/PixelIcon`), one path per colour.",
      "**Do** label anything illustrative as synthetic or an illustration, in the caption.",
      "**Do** put the claim in the lede and the evidence (a citation or an experiment link) in the same block."
    ],
    "donts": [
      "**Don't** add a second accent colour, gradients, glass, blur or soft shadows.",
      "**Don't** use coral, amber or green for anything that is not a state value.",
      "**Don't** set \"onpuck\" in Silkscreen or capitalise it.",
      "**Don't** place a kicker or eyebrow above a heading; bylines and versions go after the headline.",
      "**Don't** use text characters (+, −, #, arrows) as icons.",
      "**Don't** round corners."
    ]
  }
